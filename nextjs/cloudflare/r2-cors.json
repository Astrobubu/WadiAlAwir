{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://wadialawir.com",
          "https://www.wadialawir.com",
          "http://localhost:3000",
          "http://localhost:3100"
        ],
        "methods": ["GET", "PUT", "HEAD"],
        "headers": ["Content-Type", "Cache-Control"]
      },
      "exposeHeaders": ["ETag"],
      "maxAgeSeconds": 3600
    }
  ]
}
